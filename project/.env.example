# ─── Application ──────────────────────────────────────
APP_NAME=Open Analytics AI
APP_ENV=development
DEBUG=true

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://analytics:analytics@localhost:5432/open_analytics

# ─── API ──────────────────────────────────────────────
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# ─── Security ─────────────────────────────────────────
# !! MUST be changed before deploying to production !!
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_HASH_SECRET=
# Custom prefix for generated API keys (e.g. anal_, oaai_, app_)
API_KEY_PREFIX=anal_
# Default rate limit (requests per minute per application)
RATE_LIMIT_PER_MINUTE=60

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins for browser-based clients (e.g. Streamlit dashboard).
# API-to-API calls from client backends are not browser requests and are not affected by CORS.
# Development: CORS_ORIGINS=http://localhost:8501,http://localhost:3000
# Production:  CORS_ORIGINS=https://dashboard.yourdomain.com
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ─── AI Provider ──────────────────────────────────────
# Options: mock | local_llm (local_llm is a stub for future use)
AI_PROVIDER=mock
# Reserved for future local LLM integration (Ollama / llama.cpp)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Streamlit Dashboard ──────────────────────────────
DASHBOARD_PORT=8501
API_BASE_URL=http://localhost:8000
